ENVIRONMENT=development
APP_NAME=Telegram Bot Platform
APP_SECRET_KEY=change-this-to-a-long-random-secret
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
ADMIN_USER_IDS=
TELEGRAM_CONCURRENT_UPDATES=8
TELEGRAM_CONNECTION_POOL_SIZE=16
TELEGRAM_OVERALL_RATE_PER_SECOND=30
TELEGRAM_GROUP_RATE_PER_SECOND=20
TELEGRAM_BOOTSTRAP_RETRIES=3
WEB_HOST=0.0.0.0
WEB_PORT=8000
WEB_APP_URL=http://localhost:8000
DATABASE_URL=sqlite+aiosqlite:///./data/platform.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
LOG_LEVEL=INFO
LOG_JSON=false
TELEGRAM_TIMEOUT_SECONDS=10
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
SESSION_MAX_AGE_SECONDS=86400
SESSION_COOKIE_NAME=platform_session
SESSION_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:8000
SCHEDULER_ENABLED=true
WORKER_BATCH_SIZE=20
WORKER_POLL_INTERVAL_SECONDS=2
OUTBOX_MAX_ATTEMPTS=5
AUTO_REPLY_CACHE_TTL_SECONDS=30
AUTO_REPLY_MAX_RULES=500
DEFAULT_LOCALE=en
DEFAULT_CHANNEL_ID=

# Docker MySQL bootstrap
MYSQL_DATABASE=telegram_platform
MYSQL_USER=platform
MYSQL_PASSWORD=replace-me
MYSQL_ROOT_PASSWORD=replace-me-root
