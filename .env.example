# -----------------------------------------------------------------------------
# Core application
# -----------------------------------------------------------------------------
ENVIRONMENT=development
APP_NAME=Telegram Bot Platform
APP_SECRET_KEY=replace-with-a-long-random-secret
LOG_LEVEL=INFO
LOG_JSON=false
DEFAULT_LOCALE=en

# -----------------------------------------------------------------------------
# Modern Telegram runtime (preferred)
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
DEFAULT_CHANNEL_ID=
ADMIN_USER_IDS=
TELEGRAM_CONCURRENT_UPDATES=8
TELEGRAM_CONNECTION_POOL_SIZE=16
TELEGRAM_OVERALL_RATE_PER_SECOND=30
TELEGRAM_GROUP_RATE_PER_SECOND=20
TELEGRAM_BOOTSTRAP_RETRIES=3
TELEGRAM_TIMEOUT_SECONDS=10

# -----------------------------------------------------------------------------
# Preserved multi-runner compatibility runtime
# These variables keep the original production runner configuration usable.
# New deployments may configure only the modern runtime when legacy runners
# are not needed.
# -----------------------------------------------------------------------------
BOT_ADMIN_TOKEN=
BOT_CLIENT_TOKEN=
BOT_STAFF_TOKEN=
BOT_AUTOREPONSER_TOKEN=
CLIENT_BOT_USERNAME=
STAFF_BOT_USERNAME=
CLIENT_BOT_ID=
STAFF_BOT_ID=
ADMIN_BOT_ID=
CHANNEL_ID=0
ARCHIVE_CHANNEL=0
PHOTOS_CHANNEL=0
PROFILE_CHANNEL_TAGS=

# Backward-compatible aliases used by earlier deployments.
BOT_CUSTOMER_TOKEN=
BOT_PERSONNEL_TOKEN=
CUSTOMER_BOT_ID=
PERSTONNEL_BOT_ID=

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./data/platform.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
DB_NAME=
DB_HOST=127.0.0.1
DB_USER=
DB_PASSWORD=
DB_PORT=3306
DB_LOCATIONS=./resources/locations.db

# Docker MySQL bootstrap
MYSQL_DATABASE=telegram_platform
MYSQL_USER=platform
MYSQL_PASSWORD=replace-me
MYSQL_ROOT_PASSWORD=replace-me-root

# -----------------------------------------------------------------------------
# Mini App / web
# -----------------------------------------------------------------------------
WEB_HOST=0.0.0.0
WEB_PORT=8000
WEB_APP_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:8000
SESSION_MAX_AGE_SECONDS=86400
SESSION_COOKIE_NAME=platform_session
SESSION_COOKIE_SECURE=false

# -----------------------------------------------------------------------------
# Rate limits / workers / automation
# -----------------------------------------------------------------------------
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
SCHEDULER_ENABLED=true
WORKER_BATCH_SIZE=20
WORKER_POLL_INTERVAL_SECONDS=2
OUTBOX_MAX_ATTEMPTS=5
AUTO_REPLY_CACHE_TTL_SECONDS=30
AUTO_REPLY_MAX_RULES=500

# -----------------------------------------------------------------------------
# Compatibility runtime paths and optional integrations
# -----------------------------------------------------------------------------
IMAGES_DIR=./resources/images
WATERMARK_PATH=./resources/images/H_waterMark.png
PRIMARY_ADMIN_ID=
PRIMARY_ADMIN_USERNAME=
PRIMARY_ADMIN_NAME=Platform Owner
PRIMARY_ADMIN_PHONE=

ADMIN_SUPPORT_USERNAME=

REMOTE_HOST=
REMOTE_USER=
REMOTE_PASS=
REMOTE_UPLOAD_DIR=/tmp
DEPLOY_WORK_DIR=.
DEPLOY_BACKUP_DIR=backups
DEPLOY_ZIP_PREFIX=telegram-bot-platform